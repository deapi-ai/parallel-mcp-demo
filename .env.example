# Parallel Task API key - https://platform.parallel.ai
# A default key is generated when you sign up, so you can start without
# attaching a card. Note that the recurring $5/month credit is only granted
# to organisations with a credit card on file.
PARALLEL_API_KEY=

# deAPI key - https://app.deapi.ai/dashboard
# Note: deAPI keys contain a pipe character. Quote the value in a shell:
#   export DEAPI_API_KEY='1234|abcdef...'
DEAPI_API_KEY=
